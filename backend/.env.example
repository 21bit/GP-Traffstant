TOMTOM_API_KEY=your_tomtom_api_key_here
PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
PREDICTION_PROVIDER=mock
# PREDICTION_API_URL=https://your-external-prediction-api.example/predict

# Groq — estimates vehicle fuel efficiency (km/L) from car details.
# Trip liters and SAR cost are calculated by this server, not by the model.
# Get a key from https://console.groq.com/keys and do not commit the real value.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional overrides for the configured Aramco gasoline prices (SAR per liter).
# Defaults and the official source URL live in backend/src/config/fuelPrices.js.
# Update those defaults, or these overrides, when Aramco publishes a new monthly list.
# FUEL_PRICE_91=2.18
# FUEL_PRICE_95=2.33
